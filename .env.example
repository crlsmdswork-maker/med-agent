# ---- No Railway, cadastre estas variáveis como "Shared Variables" do projeto ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5

# Produção: https://api.woovi.com  |  Sandbox: https://api.woovi-sandbox.com
WOOVI_BASE_URL=https://api.woovi-sandbox.com
# Uma entrada por subconta BaaS. "key" vai no path do webhook.
WOOVI_ACCOUNTS=[{"key":"seller-001","appId":"APPID_DA_SUBCONTA","webhookAuth":"token-que-voce-escolheu"}]

# API que o gateway (Cloudflare) expõe para os agentes. Vazio = dados de exemplo.
GATEWAY_API_URL=https://api.seugateway.com.br
GATEWAY_API_TOKEN=gere-um-token-longo

ADMIN_TOKEN=troque-isto
SUBMIT_MODE=review
AUTO_SUBMIT_MIN_CONFIDENCE=0.85
EVIDENCE_DEADLINE_HOURS=72

# No Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}  (referência ao banco)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/med_agent
# Opcional no Railway (usa RAILWAY_PUBLIC_DOMAIN automaticamente). Local: http://localhost:3000
PUBLIC_BASE_URL=
PORT=3000
